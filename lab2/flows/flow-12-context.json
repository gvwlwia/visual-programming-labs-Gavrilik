    {
        "id": "bb58a1627032354b",
        "type": "function",
        "z": "5eb9fa4d6861454e",
        "name": "Увеличить счётчик",
        "func": "// читаем значение из flow context, если его нет, начинаем с 0\nlet counter = flow.get(\"counter\") || 0;\n\ncounter = counter + 1;\n\n// сохраняем обратно в flow context\nflow.set(\"counter\", counter);\n\nmsg.payload = {\n    author: \"Gavrilik\",\n    counter: counter\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
