    {
        "id": "bafe483b5d61ce1c",
        "type": "function",
        "z": "f037f6616e170485",
        "name": "Предметы",
        "func": "const items = [\n    { id: 1, name: \"Ноутбук\" },\n    { id: 2, name: \"Мышь\" },\n    { id: 3, name: \"Клавиатура\" }\n];\n\nconst id = msg.req.params.id;\nconst limit = msg.req.query.limit;\n\n// Вариант 1: запрос конкретного предмета /api/items/:id\nif (id !== undefined) {\n    const num = Number(id);\n    if (!Number.isInteger(num) || num <= 0) {\n        msg.statusCode = 400;\n        msg.payload = { error: \"id must be a positive integer\" };\n        return msg;\n    }\n    const found = items.find(function (item) { return item.id === num; });\n    if (!found) {\n        msg.statusCode = 404;\n        msg.payload = { error: \"item not found\", id: num };\n        return msg;\n    }\n    msg.statusCode = 200;\n    msg.payload = found;\n    return msg;\n}\n\n// Вариант 2: список /api/items?limit=N\nif (limit !== undefined) {\n    const n = Number(limit);\n    if (!Number.isInteger(n) || n <= 0) {\n        msg.statusCode = 400;\n        msg.payload = { error: \"limit must be a positive integer\" };\n        return msg;\n    }\n    msg.statusCode = 200;\n    msg.payload = items.slice(0, n);\n    return msg;\n}\n\n// Без параметров: весь список\nmsg.statusCode = 200;\nmsg.payload = items;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
