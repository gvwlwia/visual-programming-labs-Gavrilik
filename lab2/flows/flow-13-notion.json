        "name": "Запрос выборки",
        "func": "const DATABASE_ID = \"3ec933213ac58090be0aeae9a451804b\";\n\nmsg.url = \"https://api.notion.com/v1/databases/\" + DATABASE_ID + \"/query\";\nmsg.headers = {\n    \"Notion-Version\": \"2022-06-28\",\n    \"Content-Type\": \"application/json\"\n};\nmsg.payload = {\n    page_size: 10,\n    sorts: [{ timestamp: \"created_time\", direction: \"descending\" }]\n};\nreturn msg;",
