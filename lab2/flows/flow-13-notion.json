    {
        "id": "ef434fb976f508e4",
        "type": "function",
        "z": "4486e4edb8748d4f",
        "name": "Разобрать ответ",
        "func": "if (msg.statusCode !== 200) {\n    msg.payload = { error: msg.payload };\n    return msg;\n}\n\nconst rows = [];\nfor (const page of msg.payload.results) {\n    const p = page.properties;\n    rows.push({\n        name: p.Name.title.length ? p.Name.title[0].plain_text : \"\",\n        value: p.Value.number,\n        author: p.Author.rich_text.length ? p.Author.rich_text[0].plain_text : \"\"\n    });\n}\nmsg.payload = rows;\nreturn msg;",
