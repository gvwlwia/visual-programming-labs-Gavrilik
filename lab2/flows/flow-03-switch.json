    {
        "id": "1bf69400ba0b4b90",
        "type": "function",
        "z": "66d4f8bc94f3874a",
        "name": "Сумма чисел 1..N",
        "func": "// Считаем сумму чисел от 1 до N\nconst numbers = [];\nfor (let i = 1; i <= msg.payload; i++) {\n    numbers.push(i);\n}\n\nlet sum = 0;\nfor (const n of numbers) {\n    sum += n;\n}\n\nconst result = { count: numbers.length, sum: sum, author: \"Gavrilik\" };\n\nif (sum > 20) {\n    result.level = \"big\";\n} else {\n    result.level = \"small\";\n}\n\nreturn { payload: result, topic: \"lab2/Gavrilik/switch\" };",
